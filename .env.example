# =============================================================================
# Consilium Admin — единый конфиг (.env)
# Скопируйте: cp .env.example .env
# =============================================================================

# Админ-панель (внешний порт)
# http://5.42.113.18:8082
ADMIN_PORT=8082

# Бэкенд API — куда nginx в Docker проксирует /api, /uploads, /health
# Тот же сервер: http://172.17.0.1:8081
# Другой хост:    http://5.42.113.18:8081
API_UPSTREAM=http://5.42.113.18:8081

# Прямой URL API для npm run dev (из браузера на вашем ПК)
# Для Docker не используется — там nginx проксирует на API_UPSTREAM
VITE_API_BASE_URL=http://5.42.113.18:8081
